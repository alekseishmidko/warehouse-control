{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "database", "auth", "resources"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository", "digest", "pullPolicy"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "enum": ["IfNotPresent", "Never"]
        }
      }
    },
    "database": {
      "type": "object",
      "required": ["runtimeSecret", "migrationSecret"],
      "properties": {
        "runtimeSecret": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
        },
        "migrationSecret": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
        }
      }
    },
    "auth": {
      "type": "object",
      "required": ["origin", "absoluteSeconds", "idleSeconds"],
      "properties": {
        "origin": {
          "type": "string",
          "pattern": "^https://[^/]+$"
        },
        "absoluteSeconds": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "idleSeconds": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      }
    },
    "resources": {
      "type": "object",
      "required": ["requests", "limits"],
      "properties": {
        "requests": {
          "type": "object",
          "required": ["cpu", "memory"],
          "properties": {
            "cpu": {
              "type": "string",
              "minLength": 1
            },
            "memory": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "limits": {
          "type": "object",
          "required": ["cpu", "memory"],
          "properties": {
            "cpu": {
              "type": "string",
              "minLength": 1
            },
            "memory": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "gateway": {
      "type": "object",
      "required": ["enabled", "hostname", "tlsSecret", "webService", "webPort"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "hostname": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$",
          "maxLength": 253
        },
        "tlsSecret": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$",
          "maxLength": 253
        },
        "webService": {
          "type": "string",
          "pattern": "^$|^[a-z]([a-z0-9-]*[a-z0-9])?$",
          "maxLength": 63
        },
        "webPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "redirectPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "web": {
      "type": "object",
      "required": ["enabled", "image"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "required": ["repository", "digest", "pullPolicy"],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string"
            },
            "pullPolicy": {
              "enum": ["IfNotPresent", "Never"]
            }
          }
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "image": {
            "properties": {
              "digest": {
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
