{
  "uid": "wms-operation",
  "title": "Пользовательская операция",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "HTTP latency p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by(le) (rate(wms_http_duration_seconds_bucket[5m])))"
        }
      ],
      "description": "HTTP целиком, включая health probes; business results показаны отдельно, документ ищется в логах и traces."
    },
    {
      "id": 2,
      "title": "HTTP results",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(event) (rate(wms_events_total{event=~\"http.*\"}[1m]))"
        }
      ]
    },
    {
      "id": 3,
      "title": "Business commands: committed / replayed / failed",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(event) (rate(wms_events_total{event=~\"operation.completed|operation.replayed|operation.failed\"}[1m]))"
        }
      ]
    },
    {
      "id": 99,
      "title": "Поиск сценария: API + worker + CLI",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=\"warehouse-backend\"} | json | correlationId =~ \"$correlationId\" | eventId =~ \"$eventId\" | aggregateId =~ \"$aggregateId\" | errorCode =~ \"$errorCode\""
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "correlationId",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "label": "correlationId"
      },
      {
        "name": "eventId",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "label": "eventId"
      },
      {
        "name": "aggregateId",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "label": "aggregateId"
      },
      {
        "name": "errorCode",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "label": "errorCode"
      }
    ]
  }
}
