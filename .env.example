# Только локальная разработка. Это публичные dev-значения, не production credentials.
NODE_ENV=development
# Порт API при запуске на host (pnpm dev / dev:all).
PORT=4400
# HTTP bind; auth/ACL действуют и в development.
HTTP_HOST=127.0.0.1
# Старый dev actor удалён. true приводит к отказу startup; fallback не существует.
DEV_ACTOR_ENABLED=false
POSTGRES_USER=warehouse
POSTGRES_PASSWORD=warehouse_local_only
POSTGRES_DB=warehouse
POSTGRES_PORT=15432
# При смене POSTGRES_* синхронно обновите URL; пароль должен быть URL-encoded.
DATABASE_URL=postgresql://warehouse:warehouse_local_only@127.0.0.1:15432/warehouse

# Worker-only settings; business handler inventory.putaway подключён WMS-110.
# batch <=4 оставляет одно соединение pool=5 для технических операций.
WORKER_BATCH_SIZE=4
WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_MS=30000
WORKER_RETRY_BASE_MS=1000
WORKER_RETRY_MAX_MS=60000
WORKER_MAX_ATTEMPTS=10
# PostgreSQL 17 whole-transaction bound < lease; shutdown deadline > transaction timeout.
WORKER_TRANSACTION_TIMEOUT_MS=10000
WORKER_SHUTDOWN_TIMEOUT_MS=15000

# Local inspect/retry/signal CLI: explicit NODE_ENV dev/test, loopback DB и warehouse_outbox_admin.
# Не включает production auth или внешние уведомления; по умолчанию administrative CLI выключена.
OUTBOX_ADMIN_ENABLED=false

# Docker app overlay only: separate URL, postgres DNS/internal port, URL-encoded password.
# Local dev owner used for the learning stack; production login/RBAC provisioning is not implemented.
CONTAINER_DATABASE_URL=postgresql://warehouse:warehouse_local_only@postgres:5432/warehouse
# Внешний порт API для app:up; внутри контейнера API слушает 3000.
API_PORT=4400

# WMS-202: origin ровно scheme://host[:port], без path/credentials. Host development HTTP только loopback.
# Для compose.app (NODE_ENV=production) используется отдельный CONTAINER_AUTH_ORIGIN.
# Локальный Solid UI и pnpm dev:all используют origin web; он должен отличаться от PORT API.
# Vite /api proxy сохраняет Origin; CORS не включать. Инструкция — apps/web/README.md.
AUTH_ORIGIN=http://127.0.0.1:5173
# Необязательный override Compose origin (default https://warehouse.local).
# HTTPS origin браузера за будущим TLS gateway; backend сам TLS не завершает.
# Укажите реальный адрес gateway перед использованием browser login в контейнерном стенде.
CONTAINER_AUTH_ORIGIN=https://warehouse.local
# Обязательная явная policy, без скрытых defaults. Допустимо 30..86400 секунд, idle<=absolute.
# Числовые сроки пока не утверждены; оператор должен заполнить оба значения перед API startup.
AUTH_SESSION_ABSOLUTE_SECONDS=
AUTH_SESSION_IDLE_SECONDS=
# Одноразовый CLI opt-in, не разрешение HTTP-регистрации; оставить выключенным обычно.
IDENTITY_BOOTSTRAP_ENABLED=false
