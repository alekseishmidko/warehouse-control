# Только локальная разработка. Это публичные dev-значения, не production credentials.
NODE_ENV=development
PORT=3000
# HTTP bind; dev actor допускается только на 127.0.0.1 или ::1.
HTTP_HOST=127.0.0.1
# Выключен по умолчанию. Включать только для локального явно заданного dev/test.
DEV_ACTOR_ENABLED=false
DEV_ACTOR_ID=dbb37b21-1c4a-4b32-9307-148df1647f4c
POSTGRES_USER=warehouse
POSTGRES_PASSWORD=warehouse_local_only
POSTGRES_DB=warehouse
POSTGRES_PORT=15432
# При смене POSTGRES_* синхронно обновите URL; пароль должен быть URL-encoded.
DATABASE_URL=postgresql://warehouse:warehouse_local_only@127.0.0.1:15432/warehouse

# Worker-only settings; business handler inventory.putaway подключается в WMS-110.
# batch <=4 оставляет одно соединение pool=5 для технических операций.
WORKER_BATCH_SIZE=4
WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_MS=30000
WORKER_RETRY_BASE_MS=1000
WORKER_RETRY_MAX_MS=60000
WORKER_MAX_ATTEMPTS=10
# PostgreSQL 17 whole-transaction bound < lease; shutdown deadline > transaction timeout.
WORKER_TRANSACTION_TIMEOUT_MS=10000
WORKER_SHUTDOWN_TIMEOUT_MS=15000
