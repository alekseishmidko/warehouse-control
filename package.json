{
  "name": "warehouse_controller",
  "version": "1.0.0",
  "description": "Warehouse controller monorepo",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "pnpm --filter @warehouse/backend dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "start": "pnpm --filter @warehouse/backend start",
    "db:up": "docker compose --env-file .env -f infra/compose/compose.yaml up -d --wait",
    "db:down": "docker compose --env-file .env -f infra/compose/compose.yaml down",
    "db:generate": "pnpm --filter @warehouse/backend db:generate",
    "db:migrate": "pnpm --filter @warehouse/backend db:migrate",
    "db:check": "pnpm --filter @warehouse/backend db:check",
    "test:config": "pnpm test:unit",
    "test:db-baseline": "pnpm build && pnpm --filter @warehouse/backend test:db-baseline",
    "test": "pnpm --filter @warehouse/backend test",
    "test:unit": "pnpm --filter @warehouse/backend test:unit",
    "test:integration": "pnpm --filter @warehouse/backend test:integration",
    "db:seed": "pnpm --filter @warehouse/backend db:seed",
    "contracts:generate": "pnpm --filter @warehouse/backend contracts:generate",
    "contracts:check": "pnpm --filter @warehouse/backend contracts:check",
    "openapi:generate": "pnpm --filter @warehouse/backend openapi:generate",
    "openapi:check": "pnpm --filter @warehouse/backend openapi:check"
  },
  "private": true
}
