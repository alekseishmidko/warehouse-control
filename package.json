{
  "name": "warehouse_controller",
  "version": "1.0.0",
  "description": "Warehouse controller monorepo",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "pnpm --filter @warehouse/backend dev",
    "dev:all": "node scripts/dev-all.cjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "start": "pnpm --filter @warehouse/backend start",
    "db:up": "docker compose --env-file .env -f infra/compose/compose.yaml up -d --wait",
    "db:down": "docker compose --env-file .env -f infra/compose/compose.yaml down",
    "db:generate": "pnpm --filter @warehouse/backend db:generate",
    "db:migrate": "pnpm --filter @warehouse/backend db:migrate",
    "db:check": "pnpm --filter @warehouse/backend db:check",
    "test:config": "pnpm test:unit",
    "test:db-baseline": "pnpm build && pnpm --filter @warehouse/backend test:db-baseline",
    "test": "pnpm --filter @warehouse/backend test",
    "test:unit": "pnpm --filter @warehouse/backend test:unit",
    "test:integration": "pnpm --filter @warehouse/backend test:integration",
    "db:seed": "pnpm --filter @warehouse/backend db:seed",
    "contracts:generate": "pnpm --filter @warehouse/backend contracts:generate",
    "contracts:check": "pnpm --filter @warehouse/backend contracts:check",
    "openapi:generate": "pnpm --filter @warehouse/backend openapi:generate",
    "openapi:check": "pnpm --filter @warehouse/backend openapi:check",
    "worker": "pnpm --filter @warehouse/backend worker",
    "outbox:inspect": "pnpm --filter @warehouse/backend outbox:inspect",
    "outbox:retry": "pnpm --filter @warehouse/backend outbox:retry",
    "outbox:signal": "pnpm --filter @warehouse/backend outbox:signal",
    "outbox:recovery-check": "pnpm --filter @warehouse/backend outbox:recovery-check",
    "docker:build": "docker build -f apps/backend/Dockerfile -t warehouse-backend:local .",
    "app:up": "docker compose --env-file .env -f infra/compose/compose.yaml -f infra/compose/compose.app.yaml up -d --build --wait api worker",
    "app:down": "docker compose --env-file .env -f infra/compose/compose.yaml -f infra/compose/compose.app.yaml down",
    "app:migrate": "docker compose --env-file .env -f infra/compose/compose.yaml -f infra/compose/compose.app.yaml run --rm migrate",
    "docker:gate": "pnpm test:postgres:readiness && node scripts/docker-gate.cjs",
    "docker:image-check": "node scripts/docker-image-check.cjs",
    "identity:bootstrap": "pnpm --filter @warehouse/backend identity:bootstrap",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:identity:coverage": "pnpm --filter @warehouse/backend test:identity:coverage",
    "test:functional": "pnpm --filter @warehouse/backend test:functional",
    "check:pr": "pnpm format:check && pnpm lint && pnpm check:architecture && pnpm test:quality && pnpm test:dependencies && pnpm test:kubernetes:observations && pnpm test:observability:receiver && pnpm test:dev && pnpm web:api:check && pnpm typecheck && pnpm --filter @warehouse/web build && pnpm test:web && pnpm test:web:server && pnpm test:postgres:readiness && pnpm --filter @warehouse/backend test:pr",
    "lint": "eslint apps/backend/src apps/backend/test apps/web/src apps/web/test apps/web/vite.config.ts --max-warnings 0",
    "check:architecture": "node scripts/quality/architecture.cjs",
    "test:quality": "node --test scripts/quality/*.test.cjs",
    "test:dev": "node --test scripts/dev-all.test.cjs",
    "test:coverage": "pnpm --filter @warehouse/backend test:coverage",
    "web:dev": "pnpm --filter @warehouse/web dev",
    "web:api:generate": "pnpm --filter @warehouse/web api:generate",
    "web:api:check": "pnpm --filter @warehouse/web api:check",
    "test:web": "pnpm --filter @warehouse/web test",
    "test:web:gate": "pnpm --filter @warehouse/backend test:web:gate",
    "dev:backend": "pnpm --filter @warehouse/backend dev",
    "kubernetes:gate": "node scripts/kubernetes-gate.cjs",
    "test:web:server": "node --test apps/web/server/static-server.test.cjs",
    "lifecycle:gate": "WMS_LIFECYCLE=1 WMS_GATEWAY=1 node scripts/kubernetes-gate.cjs",
    "gateway:gate": "WMS_GATEWAY=1 node scripts/kubernetes-gate.cjs",
    "test:postgres:readiness": "node --test scripts/postgres-readiness.test.cjs",
    "test:dependencies": "node --test scripts/dependency-compat.test.cjs",
    "test:kubernetes:observations": "node --test scripts/kubernetes-state.test.cjs",
    "observability:gate": "WMS_OBSERVABILITY=1 node scripts/docker-gate.cjs",
    "test:observability:receiver": "node --test scripts/observability/receiver.test.cjs",
    "observability:up": "docker compose --env-file /dev/null --project-name \"${WMS_OBSERVABILITY_PROJECT:-wms-observability}\" -f infra/observability/compose.yaml up -d --wait",
    "observability:down": "docker compose --env-file /dev/null --project-name \"${WMS_OBSERVABILITY_PROJECT:-wms-observability}\" -f infra/observability/compose.yaml down"
  },
  "private": true,
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "eslint": "10.14.0",
    "eslint-plugin-solid": "0.18.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "pnpm": {
    "overrides": {
      "body-parser@2.3.0": "2.4.0",
      "multer@2.4.0": "2.5.0",
      "js-yaml@5.3.0": "5.4.1",
      "fast-uri@3.1.8": "3.1.9",
      "@esbuild-kit/core-utils@3.3.2>esbuild": "0.25.12",
      "glob@>=9.0.0 <=14.0.1": "14.0.2",
      "minimatch@>=7.0.0 <11.0.1": "11.0.5"
    },
    "patchedDependencies": {
      "deepmerge@4.3.1": "patches/deepmerge@4.3.1.patch"
    }
  }
}
