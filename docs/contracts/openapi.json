{
  "openapi": "3.0.0",
  "paths": {
    "/": {
      "get": {
        "operationId": "AppController_getHello",
        "parameters": [
          {
            "in": "header",
            "name": "X-Correlation-Id",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Не задан → UUID сервера; некорректный → 400. Ответ содержит X-Correlation-Id."
          }
        ],
        "responses": {
          "200": {
            "description": "Имя технического API без бизнес-эффектов.",
