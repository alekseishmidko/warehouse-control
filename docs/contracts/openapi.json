  "info": {
    "title": "Warehouse Controller API",
    "description": "Технические endpoints и приёмка draft → posted. Бизнес-routes доступны только с изолированным server-side dev/test actor; production authentication ещё нет.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "CreateReceiptLineDto": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647,
            "example": 10
          }
        },
        "required": [
          "productId",
          "quantity"
        ]
      },
      "CreateReceiptDto": {
        "type": "object",
        "properties": {
          "warehouseId": {
            "type": "string",
            "format": "uuid"
          },
          "receivingLocationId": {
            "type": "string",
            "format": "uuid"
          },
          "lines": {
            "minItems": 1,
            "maxItems": 1000,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreateReceiptLineDto"
            }
          }
        },
        "required": [
          "warehouseId",
          "receivingLocationId",
          "lines"
        ]
      },
      "ReceiptLineDto": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647,
            "example": 10
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "position": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        },
        "required": [
          "productId",
          "quantity",
          "id",
          "position"
        ]
      },
      "ReceiptDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "warehouseId": {
            "type": "string",
            "format": "uuid"
          },
          "receivingLocationId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "posted"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "postedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "postedEventId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "lines": {
            "minItems": 1,
            "maxItems": 1000,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReceiptLineDto"
            }
          }
        },
