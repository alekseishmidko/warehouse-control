            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "headers": {
              "X-Correlation-Id": {
                "description": "Идентификатор текущего HTTP запроса, включая replay.",
