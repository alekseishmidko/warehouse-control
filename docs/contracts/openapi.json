            },
            "description": "Не задан → UUID сервера; некорректный → 400. Ответ содержит X-Correlation-Id."
          }
        ],
        "responses": {
          "200": {
            "description": "Liveness процесса, не readiness БД.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  }
                }
              }
            },
