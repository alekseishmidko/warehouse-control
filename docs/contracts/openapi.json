  "info": {
    "title": "Warehouse Controller API",
    "description": "Технические endpoints реализованы. Приёмка и бизнес-команды появятся в WMS-108.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code",
          "correlationId"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "enum": [
              "VALIDATION_FAILED",
              "INVALID_CORRELATION_ID",
              "IDEMPOTENCY_KEY_REQUIRED",
              "INVALID_IDEMPOTENCY_KEY",
              "DEV_ACTOR_UNAVAILABLE",
              "IDEMPOTENCY_CONFLICT",
              "REQUEST_TOO_LARGE",
              "NOT_FOUND",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "CONFLICT",
              "OPERATION_REJECTED",
              "SERVICE_UNAVAILABLE",
              "INTERNAL_ERROR"
            ]
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "in": "header",
        "name": "Idempotency-Key",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "description": "Правило будущих команд: scope actor/operation/key, изменённый нормализованный запрос с тем же ключом → 409. Бизнес-endpoints ещё не реализованы."
      }
    }
  }
}
