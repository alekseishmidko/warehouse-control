{
  "name": "@warehouse/backend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "start": "node dist/main.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "pnpm build && node dist/infrastructure/database/migrate.js",
    "db:check": "node dist/infrastructure/database/check.js",
    "test:config": "pnpm test:unit",
    "test:db-baseline": "node --test test/database-baseline.test.cjs",
    "test:prepare": "pnpm contracts:check && pnpm build && node scripts/generate-openapi.cjs --check && node -e \"require('node:fs').rmSync('.test-dist', { recursive: true, force: true })\" && tsc -p tsconfig.test.json",
    "test": "pnpm test:prepare && jest",
    "test:unit": "pnpm test:prepare && jest --selectProjects unit",
    "test:integration": "pnpm test:prepare && jest --selectProjects integration",
    "db:seed": "pnpm build && node dist/infrastructure/database/seed-dev.js",
    "contracts:generate": "node scripts/generate-event-contracts.cjs",
    "contracts:check": "node scripts/generate-event-contracts.cjs --check",
    "openapi:generate": "pnpm build && node scripts/generate-openapi.cjs",
    "openapi:check": "pnpm build && node scripts/generate-openapi.cjs --check",
    "worker": "node dist/worker.js",
    "outbox:inspect": "node dist/infrastructure/outbox/outbox-admin.js inspect",
    "outbox:retry": "node dist/infrastructure/outbox/outbox-admin.js retry",
    "outbox:signal": "node dist/infrastructure/outbox/outbox-admin.js signal",
    "outbox:recovery-check": "pnpm test:prepare && jest --selectProjects integration --runInBand --runTestsByPath .test-dist/test/integration/outbox-recovery.spec.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "11.4.7",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "11.2.7",
    "@testcontainers/postgresql": "12.2.1",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "^22.18.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "jest": "30.5.2",
    "json-schema-to-typescript": "16.0.0",
    "supertest": "7.3.1",
    "typescript": "^5.9.2"
  }
}
