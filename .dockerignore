# WMS-112: разрешаем только перечисленные build inputs; .env, Git и host artifacts не передаются BuildKit.
# Сначала исключаем всё, затем открываем родительские каталоги и конкретные файлы/деревья.
# Новая build-зависимость требует явного расширения этого списка и проверки docker:image-check.
**
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.base.json
!apps/
!apps/backend/
!apps/backend/package.json
!apps/backend/Dockerfile
!apps/backend/nest-cli.json
!apps/backend/tsconfig.json
!apps/backend/tsconfig.build.json
!apps/backend/src/
!apps/backend/src/**
!apps/backend/drizzle/
!apps/backend/drizzle/**
# WMS-303: source web build и один runtime server; tests и host artifacts не передаются.
!apps/web/
!apps/web/package.json
!apps/web/Dockerfile
!apps/web/tsconfig.json
!apps/web/vite.config.ts
!apps/web/index.html
!apps/web/src/
!apps/web/src/**
!apps/web/server/
!apps/web/server/static-server.cjs

# Проверяемый security patch — часть lockfile inputs, без произвольных файлов из patches.
!patches/
!patches/deepmerge@4.3.1.patch
